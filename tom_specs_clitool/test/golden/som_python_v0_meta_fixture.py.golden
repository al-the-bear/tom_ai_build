def _cx(cls, stack, kids, make):
    """Builds a complex/section (or list-element) node with the bridge's
    cycle rule: a class already on the descent *stack* becomes a terminal
    re-entry node (``recursive=True``, no children)."""
    if cls in stack:
        return make(True, [])
    stack.add(cls)
    c = kids(stack)
    stack.remove(cls)
    return make(False, c)

