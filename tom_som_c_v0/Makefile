# Builds the generated tom_som_c_v0 typed facade against tom_som_c_runtime.

# VERSION is the TomSpecs model version; the pkg-config Version and the
# dist tarball both track it, matching the runtime.
VERSION := 1.0.0
NAME := tom_som_c_v0

RUNTIME_DIR ?= ../tom_som_c_runtime
CC ?= cc
AR ?= ar
CFLAGS ?= -std=c11 -Wall -Wextra -O2
PICFLAGS := -fPIC
CPPFLAGS += -Iinclude -I$(RUNTIME_DIR)/include

# Install layout (GNU-standard; DESTDIR-aware for staged installs).
PREFIX       ?= /usr/local
INCLUDEDIR   ?= $(PREFIX)/include
LIBDIR       ?= $(PREFIX)/lib
PKGCONFIGDIR ?= $(LIBDIR)/pkgconfig

BUILD := build
STATIC := $(BUILD)/lib$(NAME).a
SHARED := $(BUILD)/lib$(NAME).so
# soname carries only the major version (ABI compatibility boundary).
SONAME := lib$(NAME).so.$(firstword $(subst ., ,$(VERSION)))
PC     := $(BUILD)/$(NAME).pc
OBJ    := $(BUILD)/tom_som_c_v0.o
PICOBJ := $(BUILD)/tom_som_c_v0.pic.o
RUNTIME_LIB := $(RUNTIME_DIR)/build/libtom_som_c_runtime.a
HEADER := include/tom_som_c_v0.h

.PHONY: all clean runtime install dist FORCE
all: $(STATIC) $(SHARED) $(PC)

FORCE:

# Build the generic runtime static library on demand.
runtime:
	$(MAKE) -C $(RUNTIME_DIR)

$(RUNTIME_LIB): runtime

$(OBJ): src/tom_som_c_v0.c $(HEADER) | $(BUILD)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(PICOBJ): src/tom_som_c_v0.c $(HEADER) | $(BUILD)
	$(CC) $(CFLAGS) $(PICFLAGS) $(CPPFLAGS) -c $< -o $@

$(STATIC): $(OBJ)
	$(AR) rcs $@ $^

# The shared facade leaves the runtime symbols undefined; they are resolved
# when the consumer links the runtime library (matching the static path).
$(SHARED): $(PICOBJ)
	$(CC) -shared -Wl,-soname,$(SONAME) -o $@ $^

# pkg-config metadata; Version tracks the model version, Requires pulls the
# runtime .pc so consumers get its include/link flags too. Regenerated on
# every build (FORCE) so an install-time PREFIX override lands in the .pc.
$(PC): FORCE | $(BUILD)
	@printf '%s\n' \
	  'prefix=$(PREFIX)' \
	  'exec_prefix=$${prefix}' \
	  'libdir=$(LIBDIR)' \
	  'includedir=$(INCLUDEDIR)' \
	  '' \
	  'Name: $(NAME)' \
	  'Description: Generated typed TomSpecs object-model facade (C).' \
	  'Version: $(VERSION)' \
	  'Requires: tom_som_c_runtime' \
	  'Libs: -L$${libdir} -l$(NAME)' \
	  'Cflags: -I$${includedir}' \
	  > $@

$(BUILD):
	mkdir -p $(BUILD)

# Install the header, the static + shared libraries (with the versioned
# soname symlinks), and the pkg-config file. Honours DESTDIR.
install: all
	install -d $(DESTDIR)$(INCLUDEDIR) $(DESTDIR)$(LIBDIR) $(DESTDIR)$(PKGCONFIGDIR)
	install -m 0644 $(HEADER) $(DESTDIR)$(INCLUDEDIR)/
	install -m 0644 $(STATIC) $(DESTDIR)$(LIBDIR)/
	install -m 0755 $(SHARED) $(DESTDIR)$(LIBDIR)/lib$(NAME).so.$(VERSION)
	ln -sf lib$(NAME).so.$(VERSION) $(DESTDIR)$(LIBDIR)/$(SONAME)
	ln -sf $(SONAME) $(DESTDIR)$(LIBDIR)/lib$(NAME).so
	install -m 0644 $(PC) $(DESTDIR)$(PKGCONFIGDIR)/

# Source distribution tarball, versioned by the model version.
DIST := $(NAME)-$(VERSION)
DIST_FILES := Makefile $(wildcard README.md LICENSE CHANGELOG.md readme_howtointegrate.md)
DIST_DIRS := src include $(wildcard meta schemas examples)
dist:
