// meta_cx builds a complex/section (or list-element) node with the bridge's
// cycle rule: a class already on the descent stack becomes a terminal
// re-entry node (recursive: true, no children).
fn meta_cx(
    cls: &str,
    stack: &mut HashSet<String>,
    kids: fn(&mut HashSet<String>) -> Vec<Rc<som::SomMetaNode>>,
    build: impl FnOnce(bool, Vec<Rc<som::SomMetaNode>>) -> som::SomMetaNode,
) -> Rc<som::SomMetaNode> {
    if stack.contains(cls) {
        return Rc::new(build(true, Vec::new()));
    }
    stack.insert(cls.to_string());
    let c = kids(stack);
    stack.remove(cls);
    Rc::new(build(false, c))
}

