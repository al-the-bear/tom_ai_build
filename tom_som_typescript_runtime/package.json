{
  "name": "tom_som_typescript_runtime",
  "version": "1.1.0",
  "description": "TypeScript port of the generic TomSpecs object-model runtime (paths, model, reflection, document, validator, YAML/Markdown codecs). Zero external runtime dependencies (Node built-ins only); typescript is a dev dependency.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/src/",
    "README.md",
    "readme_howtointegrate.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node dist/tests/conformance_runner.js",
    "conformance": "node dist/tests/conformance_runner.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "^22"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/al-the-bear/tom_ai_build.git",
    "directory": "tom_som_typescript_runtime"
  },
  "private": true
}
