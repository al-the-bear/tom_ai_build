{
  "name": "tom_som_typescript_v0",
  "version": "1.6.0",
  "private": true,
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/al-the-bear/tom_ai_build.git",
    "directory": "tom_som_typescript_v0"
  },
  "description": "Generated typed TomSpecs object model (v0). An editing facade over the generic tom_som_typescript_runtime; see the meta-data file and DocSpecs schemas in this package. Regenerate with tom_specs_clitool/bin/generate_som.dart.",
  "main": "dist/tom_som_typescript_v0.js",
  "types": "dist/tom_som_typescript_v0.d.ts",
  "type": "commonjs",
  "files": [
    "dist/tom_som_typescript_v0.js",
    "dist/tom_som_typescript_v0.d.ts",
    "dist/tom_som_typescript_v0_meta.js",
    "dist/tom_som_typescript_v0_meta.d.ts",
    "dist/tom_som_typescript_v0_schemas.js",
    "dist/tom_som_typescript_v0_schemas.d.ts",
    "meta/",
    "schemas/",
    "README.md",
    "readme_howtointegrate.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/tom_som_typescript_v0.d.ts",
      "default": "./dist/tom_som_typescript_v0.js"
    },
    "./meta": "./meta/spec_model.meta.json",
    "./schemas": {
      "types": "./dist/tom_som_typescript_v0_schemas.d.ts",
      "default": "./dist/tom_som_typescript_v0_schemas.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "npm --prefix ../tom_som_typescript_runtime run build",
    "build": "tsc",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "tom_som_typescript_runtime": "^1.6.0"
  },
  "devDependencies": {
    "tom_som_typescript_runtime": "file:../tom_som_typescript_runtime",
    "typescript": "6.0.3",
    "@types/node": "^22"
  }
}
