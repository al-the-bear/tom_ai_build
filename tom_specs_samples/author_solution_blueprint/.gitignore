# Generated by the sample itself, on every run.
build/

# Resolution state, per machine.
.dart_tool/

# Deliberately NOT committed. A sample's job is to show what a user gets from
# pub.dev today, so it should resolve the way a new user does. A committed lock
# would keep the sample passing against the versions that were current when it
# was written, while the packages it demonstrates moved on — green, and no
# longer true. Without one, a published change turns the samples driver red and
# somebody looks.
pubspec.lock
